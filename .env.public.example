# Public no-auth deployment example.
# Copy to `.env` on the deployment host, set mode 0600, and fill every required value.

# Public application host, without https://.
APP_DOMAIN=refgen.example.com
ACME_EMAIL=admin@example.com

# Host path to the read-only reference database mounted into API and worker.
REFERENCE_GEN2_LOCAL_DB_HOST_PATH=/data/db.sqlite

# Required app secrets. Generate separate values with:
# openssl rand -hex 32
REFERENCE_GEN2_REPORT_SERVING_OWNERSHIP_SECRET=
REFERENCE_GEN2_API_RATE_LIMIT_SECRET=

# Required public host/origin policy.
REFERENCE_GEN2_API_ALLOWED_HOSTS=refgen.example.com
REFERENCE_GEN2_API_POST_ALLOWED_ORIGINS=https://refgen.example.com

# Required proxy trust policy.
# The public Compose file creates this exact internal subnet for Caddy -> API.
# If you change INTERNAL_SUBNET, keep TRUSTED_PROXY_CIDRS aligned with it.
# Do not use broad private ranges.
REFERENCE_GEN2_INTERNAL_SUBNET=172.28.0.0/24
REFERENCE_GEN2_API_TRUSTED_PROXY_CIDRS=172.28.0.0/24

# Upload malware scanning policy.
# This deployment path does not include ClamAV by default. Set ACCEPT_RISK=1 only
# after accepting that structural PDF/DOCX validation is the upload defense.
REFERENCE_GEN2_SECURITY_SCAN_ENABLED=0
REFERENCE_GEN2_SECURITY_SCAN_EXECUTABLE=
REFERENCE_GEN2_SECURITY_SCAN_ARGS=
REFERENCE_GEN2_SECURITY_SCAN_TIMEOUT_SEC=15
REFERENCE_GEN2_SECURITY_SCAN_ACCEPT_RISK=1

# Public abuse controls. Tune to host capacity.
REFERENCE_GEN2_API_SUBMISSIONS_ENABLED=1
REFERENCE_GEN2_API_MAX_QUEUED_JOBS=20
REFERENCE_GEN2_PHASE7_WORKER_CONCURRENCY=2
REFERENCE_GEN2_API_NETWORK_BURST_WINDOW_SECONDS=3600
REFERENCE_GEN2_API_NETWORK_BURST_MAX_REQUESTS=30
REFERENCE_GEN2_API_NETWORK_SUSTAINED_WINDOW_SECONDS=28800
REFERENCE_GEN2_API_NETWORK_SUSTAINED_MAX_REQUESTS=120
REFERENCE_GEN2_API_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
REFERENCE_GEN2_API_GLOBAL_RATE_LIMIT_MAX_REQUESTS=300
REFERENCE_GEN2_API_CHALLENGE_MODE=auto
REFERENCE_GEN2_API_CHALLENGE_MAX_NUMBER=12000
REFERENCE_GEN2_API_CHALLENGE_TTL_SECONDS=300
REFERENCE_GEN2_API_CHALLENGE_SOFT_LIMIT_RATIO=0.75
REFERENCE_GEN2_API_CHALLENGE_QUEUE_RATIO=0.70

# Keep browser access same-origin unless you intentionally add a trusted frontend.
REFERENCE_GEN2_CORS_ALLOWED_ORIGINS=

# Optional document-processing limits.
# REFERENCE_GEN2_UPLOAD_MAX_BYTES=26214400
# REFERENCE_GEN2_PDF_MAX_PAGES=150
# REFERENCE_GEN2_PDF_MAX_OBJECTS=10000
# REFERENCE_GEN2_PDF_MAX_STREAMS=5000
# REFERENCE_GEN2_PDF_MAX_OBJECTS_PER_MB=2000
# REFERENCE_GEN2_EXTRACT_MAX_CHARS=200000
# REFERENCE_GEN2_EXTRACT_TIMEOUT_SEC=20
# REFERENCE_GEN2_TEXT_INPUT_MAX_CHARS=120000
